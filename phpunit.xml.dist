<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="lib/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/phpunit/bootstrap.php"
         cacheDirectory="var/cache/tools/phpunit"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/phpunit/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">lib/max</directory>
            <directory suffix=".php">lib/OA</directory>
            <directory suffix=".php">lib/OX</directory>
            <directory suffix=".php">lib/RV</directory>
        </include>
    </source>
</phpunit>
